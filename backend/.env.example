# Copia a backend/.env y completa con tus llaves sandbox de Wompi.
# Dashboard Wompi → Desarrolladores → Secretos para integración técnica

APP_ENV=development
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# Wompi sandbox (prefijos pub_test_, test_integrity_, test_events_)
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXXXXXX
WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXXXXXX
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_BASE_URL=https://production.wompi.co/v1

# Webhook en dashboard Wompi (sandbox):
#   Local con ngrok: https://TU-NGROK.ngrok.io/api/v1/payments/wompi/webhook
#   Si no hay webhook, la app usa POST /payments/wompi/confirm/{order_id} al volver del checkout.

DATABASE_URL=postgresql+asyncpg://tava:tava_secret@localhost:5432/tava_db
JWT_SECRET_KEY=dev-secret-change-in-production-min-32-chars
