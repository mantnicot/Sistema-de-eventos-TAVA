# PostgreSQL
POSTGRES_USER=tava
POSTGRES_PASSWORD=tava_secret_change_me
POSTGRES_DB=tava_db
# Local: sin sslmode. Neon/Render: postgresql+asyncpg://... (sslmode se quita solo; SSL se activa en código)
DATABASE_URL=postgresql+asyncpg://tava:tava_secret_change_me@localhost:5432/tava_db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
# Separar con coma (no punto y coma). Ej: http://localhost:4200,https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:4200
RATE_LIMIT_PER_MINUTE=60

# Captcha (hCaptcha / reCAPTCHA)
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tavateatro.com

# Wompi (sandbox: pub_test_, test_integrity_, test_events_)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_BASE_URL=https://production.wompi.co/v1

# Frontend URL (emails, links)
FRONTEND_URL=http://localhost:4200

# API pública (Render): https://tava-api-1.onrender.com
API_PUBLIC_BASE_URL=

# Cloudinary — OBLIGATORIO en Render para que imágenes/videos no se pierdan al redeploy
# Cuenta gratis: https://cloudinary.com → Settings → Upload → crear preset "unsigned"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo en producción (Render)
BREVO_API_KEY=
EMAIL_FROM=TAVA Teatro <tavateatro@gmail.com>
